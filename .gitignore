# This .gitignore file should be placed at the root of your Unity project directory.
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated folders
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# OS and editor noise
**/.DS_Store
Thumbs.db
.vs/
.gradle/
.idea/
*.DotSettings.user

# Autogenerated Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated IDE solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Logs and crash reports
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Builds and exported packages
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Blender backup files
*.blend1
*.blend1.meta

# Asset metadata should only be ignored when the corresponding asset is also ignored.
!/[Aa]ssets/**/*.meta

# Unity generated meta files for ignored generated artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta

# TestRunner generated files
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Addressables default ignores
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# TextMesh Pro resources are imported locally by the editor bootstrapper.
/[Aa]ssets/TextMesh Pro/

# Excel-files
*.xlsx
*.Response.TokenResponse-user
